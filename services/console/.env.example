# Quill console — Next.js standalone. See CONTRACT.md for the fixed
# interface these env vars serve.

# Server-side quill-api origin. Proxied via app/api/search/route.ts — never
# exposed to the browser.
QUILL_API_URL=http://localhost:8080

# Cloudflare Access (unset in local dev; middleware falls back to a fixed
# dev identity when unset).
CF_ACCESS_AUD=
CF_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
DEV_USER_EMAIL=user@example.com
